[Unit]
Description=market-bot: сторож раз в 5 минут

[Timer]
# Первый запуск — через 10 минут после включения таймера, а не сразу: при первой
# установке за это время успевает пройти бэкап с копией вне сервера, и сторож не
# начинает знакомство с ложной тревогой. После перезагрузки — те же 10 минут на
# подъём контейнеров.
OnActiveSec=10min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
