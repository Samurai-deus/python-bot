# ═══════════════════════════════════════════════════════════════════════
# Market Bot — шаблон окружения. Копировать в .env и заполнить.
# .env в git не попадает (см. .gitignore и gitleaks в pre-commit).
# ═══════════════════════════════════════════════════════════════════════

# ── Окружение ──────────────────────────────────────────────────────────
# production | development | test
# В production API отказывается стартовать с опасной конфигурацией:
# без ADMIN_CHAT_ID, без TELEGRAM_BOT_TOKEN или с DISABLE_AUTH=true.
# Незаданное значение считается боевым для DISABLE_AUTH — флаг будет проигнорирован.
ENVIRONMENT=production

# ── Доступ ─────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. Ваш Telegram user id (узнать у @userinfobot).
# Без него доступ к боту и Mini App закрыт для всех, а API в production не стартует.
# До 10.09.2026 пустое значение открывало админ-права любому пользователю Telegram.
ADMIN_CHAT_ID=

# Наблюдатели: могут смотреть баланс и позиции, но не управлять. Через запятую.
# Владелец (ADMIN_CHAT_ID) допущен всегда, повторять его здесь не нужно.
# Пусто = наблюдателей нет. Не оставляйте здесь чужой id из примеров.
ALLOWED_USER_IDS=

# ── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Куда бот шлёт уведомления (обычно совпадает с ADMIN_CHAT_ID)
TELEGRAM_CHAT_ID=
# Исходящие к api.telegram.org через прокси. Нужно там, где Telegram заблокирован
# (прод-хост в РФ: прямое соединение отваливается по таймауту). Пусто = напрямую.
# Схема http://, а не socks5://: для SOCKS httpx нужен пакет socksio, которого в
# зависимостях нет, а inbound sing-box смешанный и принимает HTTP CONNECT.
# host.docker.internal задаётся в compose через extra_hosts: host-gateway — это
# хост из любой docker-сети, а не только из стандартного моста 172.17.0.1.
# Из docker-контейнера к sing-box на хосте: http://host.docker.internal:12334
TELEGRAM_PROXY_URL=

# ── Режим торговли ─────────────────────────────────────────────────────
# Единственный источник решения — trading_mode.py. Приоритет:
#   LIVE_TRADING=true                  → LIVE     (реальные деньги, mainnet)
#   PAPER_TRADING=true                 → PAPER    (виртуальные сделки, биржа не вызывается)
#   BYBIT_TESTNET=true и DRY_RUN=false → TESTNET  (реальные ордера на testnet)
#   BYBIT_DEMO=true и DRY_RUN=false    → TESTNET  (ордера на демо-счёт api-demo.bybit.com)
#   иначе                              → DRY_RUN  (только сигналы)
# Допустимые значения: true/false, 1/0, yes/no, on/off. Любое другое — ошибка
# запуска, а не тихий false: опечатка в LIVE_TRADING не должна угадываться.
DRY_RUN=true
PAPER_TRADING=false
LIVE_TRADING=false
BYBIT_TESTNET=false
BYBIT_DEMO=false
# Потолок капитала реальных режимов (0 — нет): кошелёк виден как счёт такого размера
REAL_CAPITAL_CAP_USDT=0

# ── Бумажная торговля и размер позиции ─────────────────────────────────
# Стартовый баланс бумажного счёта (DRY_RUN и PAPER_TRADING).
# В TESTNET и LIVE баланс берётся из кошелька биржи.
PAPER_INITIAL_BALANCE_USDT=100
# Комиссия taker за одну сторону сделки, % (Bybit linear — около 0,055).
PAPER_TAKER_FEE_PCT=0.055
# Проскальзывание бумажного стопа, % от цены стопа (стоп исполняется около своей цены)
PAPER_STOP_SLIPPAGE_PCT=0.05
# Риск на сделку, % от баланса: сколько теряем при срабатывании стопа.
RISK_PERCENT=2.0
# Позицию меньше этого номинала не открываем. 5 — минимальный ордер Bybit.
MIN_POSITION_SIZE_USDT=5
MAX_POSITION_SIZE_USDT=1000

# ── Bybit ──────────────────────────────────────────────────────────────
# Ключ — только с правом торговли, без вывода средств, с IP-белым списком в кабинете.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Работа бота ────────────────────────────────────────────────────────
BOT_INTERVAL=300
MAX_CONSECUTIVE_ERRORS=5
ERROR_PAUSE=600
# Файловый лог рядом со stdout. В Docker не нужен: stdout забирает json-file с ротацией.
LOG_TO_FILE=false
LOG_FILE=/data/logs/runner.log

# ── Хранилище ──────────────────────────────────────────────────────────
DB_PATH=/data/db/market_bot.db
# Пусто = SQLite по DB_PATH. Формат: postgresql://user:password@host:5432/dbname
DATABASE_URL=
POSTGRES_DB=market_bot
POSTGRES_USER=market_bot
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Шифрование ключей биржи в БД. Потеря ключа = потеря сохранённых ключей Bybit.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── API для Mini App ───────────────────────────────────────────────────
RELEASE_TAG=latest
CORS_ORIGINS=https://telegram.org,https://web.telegram.org
# Только для локальной разработки и только при ENVIRONMENT=development|test.
# В production API с этим флагом не стартует.
DISABLE_AUTH=false

# Лимиты запросов в минуту на клиента
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=10
# openssl rand -hex 16
REDIS_PASSWORD=
# Пароль обязан совпадать с REDIS_PASSWORD. В production недоступный Redis даёт
# 503 на все запросы (раньше лимит молча выключался).
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# Второй рубеж для /api/settings, /api/system/balance и /metrics: IP/CIDR через запятую.
# Пусто = проверка выключена (доступ всё равно закрыт проверкой пользователя).
# Если включаете — добавьте docker-подсеть, иначе Prometheus получит 403 на /metrics:
# API_IP_WHITELIST=127.0.0.1,172.16.0.0/12,<ваш-ip>
API_IP_WHITELIST=

# ── Мониторинг ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── ИИ-трейдер (ai_trader, docs/AI_TRADER_PLAN.md) ──────────────────────
# Пусто — ИИ выключен, торговля идёт по правилам. Лимит кредита поставьте и на
# самом ключе в кабинете OpenRouter — это второй предохранитель бюджета.
OPENROUTER_API_KEY=
# off — выключен; 0 — тень: мнения пишутся и сверяются с исходами, на торговлю не влияют.
AI_TRADER_STAGE=0
AI_MODEL_REVIEW=anthropic/claude-sonnet-5
AI_MODEL_CHAT=anthropic/claude-opus-5
AI_DAILY_BUDGET_USD=1.0
# Прокси до OpenRouter: с IP сервера напрямую он отвечает 403. На проде — прокси
# хоста, как у Telegram; deploy.sh ai-key ставит его вместе с ключом.
AI_PROXY_URL=


# ====================================================================================================
# Остальные настройки, которые читает код (аудит 29.09.2026: 55 из 110 нигде не были описаны).
# Строка закомментирована — действует значение по умолчанию из кода (оно и показано).
# tests/test_env_example.py не даёт добавить в код новую переменную без строки здесь.
# ====================================================================================================

# --- Ключи демо-субсчетов исполнителей (обязательны для своих контейнеров; ключ бота они не берут)
BTCALTS_BYBIT_API_KEY=
BTCALTS_BYBIT_API_SECRET=
CARRY_BYBIT_API_KEY=
CARRY_BYBIT_API_SECRET=

# --- Исполнители И13 / И14 / И18 (compose задаёт капитал и каталоги; здесь — остальное)
# BTCALTS_START_THIS_WEEK=false  # разовая поправка 15.09, снята 29.09
# CARRY_NOTIONAL_USDT=10000
# CARRY_SYMBOLS=BTCUSDT,ETHUSDT
# PORTFOLIO_START_THIS_WEEK=false  # разовая поправка 14.09, снята 29.09

# --- Пределы Risk Core сигнальной торговли (действуют только при SIGNAL_TRADING_ENABLED=true)
# MAX_NEW_POSITIONS_PER_TURN=3
# RISK_ACTION_COOLDOWN_SECONDS=0
# RISK_LOSS_EVENT_WINDOW_MINUTES=15
# RISK_MAX_ACTIONS_PER_24H=100
# RISK_MAX_ACTIONS_PER_HOUR=12
# RISK_MAX_AGGREGATE_EXPOSURE_PCT=300.0
# RISK_MAX_CORRELATED_GROUP_PCT=150.0
# RISK_MAX_GROUP_RISK_PCT=3.0
# RISK_MAX_OPEN_POSITIONS=6
# RISK_MAX_OPEN_RISK_PCT=6.0
# RISK_MAX_SINGLE_POSITION_PCT=100.0

# --- Цикл анализа бота: интервал, адаптация, алерты, возобновление
# ADAPTIVE_INTERVAL_ENABLED=true
# ADAPTIVE_INTERVAL_MAX=        # по умолчанию 3 × BOT_INTERVAL
# ADAPTIVE_INTERVAL_MIN=        # по умолчанию BOT_INTERVAL
# ADAPTIVE_INTERVAL_MULTIPLIER=1.5
# ADAPTIVE_STABLE_CYCLES=3
# ALERT_ANALYSIS_TIME=60
# ALERT_COOLDOWN=300
# AUTO_RESUME_SAFE_MODE_DELAY=60
# AUTO_RESUME_SUCCESS_CYCLES=3
# AUTO_RESUME_TRADING_ENABLED=true
# CRITICAL_ERROR_THRESHOLD=5
# MAX_ANALYSIS_TIME=30
# METRICS_LOG_INTERVAL=600
# VOLATILITY_THRESHOLD=0.5
# WARN_ERROR_THRESHOLD=3

# --- Сообщения о резких движениях
# SPIKE_ALERT_COOLDOWN_SEC=1800
# SPIKE_ALERT_MIN_PCT=2.0
# SPIKE_THRESHOLD_PCT=1.5

# --- Новости, ИИ, запись стакана, межбиржевой фандинг
# AI_MODEL_NEWS=                # пусто — модель по умолчанию из news/scorer.py
# AI_NEWS_DAILY_BUDGET_USD=0.3
# NEWS_HEARTBEAT=/tmp/news-heartbeat
# RECORDER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,XAUUSDT
# XFUNDING_LIVE_DB=/data/db/xfunding_live.db

# --- Служебное: сервер здоровья, файлы, пул PG, смоук
# HEALTH_SERVER_HOST=127.0.0.1
# HEALTH_SERVER_PORT=8080
# LIVENESS_DIR=                 # пусто — каталог по умолчанию из utils/liveness.py
# PG_POOL_MAX=10
# PG_POOL_MIN=2
# PID_FILE=                     # по умолчанию market_bot.pid рядом с runner.py
# SMOKE_API_BASE=http://localhost:8000

# --- Только для испытаний и разработки — в проде не задавать
# CHAOS_ENABLED=false
# DISABLE_WS_AUTH=false
# ENABLE_SYNTHETIC_DECISION_TICK=false
# FAULT_INJECT_DECISION_EXCEPTION=false
# FAULT_INJECT_LOOP_STALL=false
# FAULT_INJECT_STORAGE_FAILURE=false
