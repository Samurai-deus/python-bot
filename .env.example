# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Claude Assistant (claude_assistant.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ALLOWED_USER_IDS=123456789
TELEGRAM_CHAT_ID=your_chat_id_here

# Bybit API (для будущего trading)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Режим работы
DRY_RUN=true
PAPER_TRADING=false
LIVE_TRADING=false

# Настройки бота
BOT_INTERVAL=300
MAX_CONSECUTIVE_ERRORS=5
ERROR_PAUSE=600
LOG_FILE=monitor.log

# Storage paths (for /data disk on server)
DB_PATH=market_bot.db

# FastAPI backend (Phase 5)
DISABLE_AUTH=true
CORS_ORIGINS=https://telegram.org,https://web.telegram.org,http://localhost:5173
# In Docker: set API_HOST=0.0.0.0 (handled by docker-compose.yml)

# Monitoring (Phase 6)
GRAFANA_PASSWORD=changeme
# Sentry: create project at sentry.io → Settings → Client Keys → DSN
SENTRY_DSN=
ENVIRONMENT=production

# Security (Phase 6)
# Your Telegram user ID — run /start and check logs, or use @userinfobot
ADMIN_CHAT_ID=
# Redis URL (docker-compose uses service name "redis")
REDIS_URL=redis://redis:6379
# API rate limits (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=10
